# Supabase PostgreSQL connection (pooled — for Prisma Client at runtime)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL connection (direct — for Prisma migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Directory for uploaded images (local dev only, ignored when BLOB_READ_WRITE_TOKEN is set)
UPLOAD_DIR="./public/uploads"

# Vercel Blob token (production) — get from Vercel dashboard → Storage → Blob
# When set, images are stored in Vercel Blob instead of the local filesystem
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
